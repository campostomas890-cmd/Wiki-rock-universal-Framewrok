                    <figcaption class="lineup-person__cap"><strong>Peter Loeffler</strong><span>Voz principal y guitarra rítmica</span></figcaption>
                </figure>
                <figure class="lineup-person">
                    <img src="/img/samloeffle.jpg" alt="Aaron Fink, guitarra" class="lineup-person__img" width="400" height="500" loading="lazy">
